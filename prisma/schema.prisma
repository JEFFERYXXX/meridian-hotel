generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
model User { id String @id @default(cuid()) email String @unique name String? createdAt DateTime @default(now()) bookings Booking[] requests ConciergeRequest[] }
model Room { id String @id @default(cuid()) slug String @unique name String maxGuests Int rate Int bookings Booking[] }
model Booking { id String @id @default(cuid()) userId String? roomId String user User? @relation(fields: [userId], references: [id]) room Room @relation(fields: [roomId], references: [id]) checkIn DateTime checkOut DateTime guests Int paymentMode String status String @default("pending") stripePaymentId String? createdAt DateTime @default(now()) @@index([roomId, checkIn, checkOut]) }
model ConciergeRequest { id String @id @default(cuid()) userId String user User @relation(fields: [userId], references: [id]) message String status String @default("open") createdAt DateTime @default(now()) }
